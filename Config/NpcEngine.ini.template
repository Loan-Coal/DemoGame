; NPC Engine connection settings — copy this file to Config/NpcEngine.ini and fill in your values.
; Config/NpcEngine.ini is gitignored and must NEVER be committed.
; These values are overridden by environment variables NPC_ENGINE_URL and NPC_ENGINE_API_KEY if set.

[NpcEngine]
; Base URL of the locally running NPC Engine (default: http://localhost:8000)
Url=http://localhost:8000

; Shared API key — must match API_KEY_SECRET in the engine's .env
; Dev default: local_dev_secret_change_this_2026
ApiKey=local_dev_secret_change_this_2026
