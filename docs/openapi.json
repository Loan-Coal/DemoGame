{
  "openapi": "3.1.0",
  "info": {
    "title": "NPC Engine API (curated subset for DemoGame)",
    "version": "slice-1",
    "description": "HAND-CURATED subset covering only the endpoints DemoGame uses, generated by reading the engine source. NOT the full spec. When the engine is running, pull the authoritative spec from GET /openapi.json and reconcile. Note: /v1/dialogue and /v1/action return RAW bodies; all other endpoints wrap the payload in an OkEnvelope ({data, meta, error})."
  },
  "servers": [{ "url": "http://localhost:8000" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "OkEnvelope": {
        "type": "object",
        "properties": {
          "data": {},
          "meta": { "type": ["object", "null"] },
          "error": { "type": ["object", "null"] }
        },
        "required": ["data"]
      },
      "DialogueRequest": {
        "type": "object",
        "required": ["player_id", "npc_id", "player_message"],
        "properties": {
          "player_id": { "type": "string" },
          "npc_id": { "type": "string" },
          "player_message": { "type": "string", "maxLength": 1000 },
          "location_id": { "type": ["string", "null"] },
          "session_id": { "type": ["string", "null"] },
          "explicit_node_ids": { "type": "array", "items": { "type": "string" }, "default": [] }
        }
      },
      "RelationDeltas": {
        "type": "object",
        "properties": {
          "trust": { "type": "integer", "minimum": -15, "maximum": 15, "default": 0 },
          "fear": { "type": "integer", "minimum": -15, "maximum": 15, "default": 0 },
          "affection": { "type": "integer", "minimum": -15, "maximum": 15, "default": 0 }
        }
      },
      "ActionModel": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "default": "speak", "description": "Closed set; unknown values coerced to 'speak'." },
          "target_id": { "type": ["string", "null"] },
          "parameters": { "type": "object", "default": {} }
        }
      },
      "FacialExpressionModel": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "default": "neutral", "description": "Closed expression set." },
          "intensity": { "type": "integer", "minimum": 0, "maximum": 100, "default": 0 }
        }
      },
      "DialogueResponse": {
        "type": "object",
        "required": ["npc_response"],
        "properties": {
          "npc_response": { "type": "string", "description": "The line to display." },
          "relation_deltas": { "$ref": "#/components/schemas/RelationDeltas" },
          "mood_update": { "type": ["string", "null"] },
          "emotion": { "type": ["string", "null"] },
          "action": { "$ref": "#/components/schemas/ActionModel" },
          "facial_expression": { "$ref": "#/components/schemas/FacialExpressionModel" },
          "learned_facts": { "type": "array", "items": { "type": "string" } },
          "memories_recalled": { "type": "array", "items": { "type": "string" } },
          "session_id": { "type": ["string", "null"] },
          "cached": { "type": "boolean", "default": false },
          "degradation_level": { "type": "string", "default": "full" },
          "audio_bytes": { "type": ["string", "null"], "description": "TTS. Null/unreliable over REST; base64 WAV via WS 'done' as audio_bytes_b64." }
        }
      },
      "ActionReportRequest": {
        "type": "object",
        "required": ["action_type", "player_id", "npc_id"],
        "properties": {
          "action_type": { "type": "string" },
          "player_id": { "type": "string" },
          "npc_id": { "type": "string" },
          "intensity": { "type": ["integer", "null"] },
          "counterparty_id": { "type": ["string", "null"] },
          "currency_amount": { "type": ["integer", "null"] },
          "session_scope": { "type": ["string", "null"] },
          "currency_reason": { "type": ["string", "null"] }
        }
      },
      "NodeWriteBody": {
        "type": "object",
        "properties": { "properties": { "type": "object", "default": {} } }
      },
      "EdgeWriteBody": {
        "type": "object",
        "required": ["src_id", "dst_id"],
        "properties": {
          "src_id": { "type": "string" },
          "dst_id": { "type": "string" },
          "properties": { "type": "object", "default": {} }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness (no auth).",
        "security": [],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkEnvelope" } } } } }
      }
    },
    "/readiness": {
      "get": {
        "summary": "Readiness incl. LLM reachability (no auth).",
        "security": [],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkEnvelope" } } } } }
      }
    },
    "/v1/dialogue": {
      "post": {
        "summary": "Run one dialogue turn. RAW response (no envelope).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DialogueRequest" } } } },
        "responses": {
          "200": { "description": "Dialogue response (raw).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DialogueResponse" } } } },
          "401": { "description": "Auth failure (no body)." },
          "422": { "description": "{ detail: { code: 'CHARACTER_NOT_FOUND', message } }" }
        }
      }
    },
    "/v1/action": {
      "post": {
        "summary": "Report a player action. RAW response { status }.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActionReportRequest" } } } },
        "responses": { "200": { "description": "{ status: 'ok'|'ignored', ... }" }, "401": { "description": "Auth failure." } }
      }
    },
    "/v1/npc/{npc_id}/state": {
      "get": {
        "summary": "NPC graph state snapshot (envelope).",
        "parameters": [
          { "name": "npc_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "include_relations", "in": "query", "schema": { "type": "boolean", "default": true } },
          { "name": "include_events", "in": "query", "schema": { "type": "boolean", "default": true } }
        ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkEnvelope" } } } } }
      }
    },
    "/v1/npc/{npc_id}/emotion": {
      "get": {
        "summary": "NPC emotion snapshot (envelope).",
        "parameters": [{ "name": "npc_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkEnvelope" } } } } }
      }
    },
    "/v1/graph/nodes/{node_type}": {
      "post": {
        "summary": "Upsert a node (seeding). Envelope response.",
        "parameters": [{ "name": "node_type", "in": "path", "required": true, "schema": { "type": "string" }, "example": "Character" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NodeWriteBody" } } } },
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkEnvelope" } } } } }
      }
    },
    "/v1/graph/nodes/{node_type}/{node_id}": {
      "get": {
        "summary": "Get one node by id (idempotency check). Envelope response; data null when absent.",
        "parameters": [
          { "name": "node_type", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "node_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkEnvelope" } } } } }
      }
    },
    "/v1/graph/edges/{edge_type}": {
      "post": {
        "summary": "Upsert an edge (seeding). Both endpoint nodes must exist. Envelope response.",
        "parameters": [{ "name": "edge_type", "in": "path", "required": true, "schema": { "type": "string" }, "example": "LOCATED_AT" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EdgeWriteBody" } } } },
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkEnvelope" } } } } }
      }
    },
    "/v1/ws/dialogue": {
      "get": {
        "summary": "WebSocket streaming dialogue (handshake; auth via Authorization header). Built, not wired in slice-1. Server pushes {type:token|done|error|proactive_line}. Max 5 conns/key.",
        "responses": { "101": { "description": "Switching Protocols." }, "1008": { "description": "Closed: auth failed or connection cap reached." } }
      }
    }
  }
}
